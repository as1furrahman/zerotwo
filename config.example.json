{
  "provider": {
    "base_url": "https://api.groq.com/openai/v1",
    "api_key": "",
    "api_key_env": "GROQ_API_KEY",
    "model": "",
    "stream": true,
    "ca_cert_file": "",
    "send_memory": null,
    "redact_sections": [
      "Key Relationships",
      "Personal Context"
    ]
  },
  "agent": {
    "name": "ZeroTwo",
    "workspace": "~/.config/zerotwo/workspace",
    "max_iterations": 15,
    "context_window": 16384,
    "max_tokens": 2048,
    "temperature": 0.7,
    "top_p": 0.8
  },
  "tools": {
    "confirm_tools": [
      "shell",
      "write_file"
    ],
    "allow_shell": true,
    "blocked_commands": [],
    "max_tool_output_size": 4096,
    "brave_api_key": "",
    "brave_api_key_env": "BRAVE_API_KEY",
    "max_search_results": 5
  },
  "timeouts": {
    "dial_seconds": 10,
    "tls_handshake_seconds": 10,
    "response_header_seconds": 30,
    "total_seconds": 120,
    "idle_seconds": 45
  }
}
